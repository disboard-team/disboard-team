---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PlayerCard from '../components/PlayerCard.astro';
import players from '../data/players.json';
import { getDiscordAvatarUrl } from '../utils/discord.js';

const isFormer = (p) => Boolean(p.player_registry?.out);
const currentStaff = players.filter((p) => p.is_staff && !isFormer(p));
const currentMembers = players.filter((p) => !p.is_staff && !isFormer(p));
const formerMembers = players.filter((p) => isFormer(p));
---

<Layout
  title="『 Disboard 』 / Miembros del equipo"
  description="Miembros y Staff de Disboard Team"
>
  <section class="contents">
    <SectionTitle title="JUGADORES" alt="選手たち" />
    <article>
      {currentStaff.length > 0 && (
        <>
          <div class="heading">
            <h3>
              <span>Staff</span>
            </h3>
          </div>
          <div class="detail players-container">
            {currentStaff.map((player) => (
              <a class="player-card" href={`/player/${player.player_id}`}>
                <PlayerCard
                  avatarURL={getDiscordAvatarUrl(player.discord?.unique_id, player.discord?.avatar)}
                  country={player.country.code}
                  name={player.player_name}
                  tag={player.player_tag}
                  inDate={player.player_registry?.in}
                  outDate={player.player_registry?.out}
                  fc={player.switch_fc}
                  role={player.player_registry?.role}
                />
              </a>
            ))}
          </div>
        </>
      )}

      {currentMembers.length > 0 && (
        <>
          <div class="heading">
            <h3>
              <span>Miembros</span>
            </h3>
          </div>
          <div class="detail players-container members">
            {currentMembers.map((player) => (
              <a class="player-card" href={`/player/${player.player_id}`}>
                <PlayerCard
                  avatarURL={getDiscordAvatarUrl(player.discord?.unique_id, player.discord?.avatar)}
                  country={player.country.code}
                  name={player.player_name}
                  tag={player.player_tag}
                  inDate={player.player_registry?.in}
                  outDate={player.player_registry?.out}
                  fc={player.switch_fc}
                  role={player.player_registry?.role}
                />
              </a>
            ))}
          </div>
        </>
      )}

      {formerMembers.length > 0 && (
        <>
          <div class="heading">
            <h3>
              <span>Ex-miembros</span>
            </h3>
          </div>
          <div class="detail players-container former">
            {formerMembers.map((player) => (
              <a class="player-card" href={`/player/${player.player_id}`}>
                <PlayerCard
                  avatarURL={getDiscordAvatarUrl(player.discord?.unique_id, player.discord?.avatar)}
                  country={player.country.code}
                  name={player.player_name}
                  tag={player.player_tag}
                  inDate={player.player_registry?.in}
                  outDate={player.player_registry?.out}
                  fc={player.switch_fc}
                  role={player.player_registry?.role}
                />
              </a>
            ))}
          </div>
        </>
      )}
    </article>
  </section>
</Layout>