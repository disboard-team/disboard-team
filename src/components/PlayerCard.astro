---
interface Props {
  avatarURL?: string;
  country?: string;
  name: string;
  tag?: string;
  inDate?: string;
  fc?: string;
}

const { avatarURL, country = 'es', name, tag, inDate, fc } = Astro.props;
const countryCode = (country || 'es').toLowerCase();
const avatar = avatarURL || 'https://cdn.discordapp.com/embed/avatars/0.png';
---

<div class="player-card-inner">
  <img src={avatar} alt={name} loading="lazy" />
  <div class="player-description">
    <div>
      <span class={`fi fi-${countryCode} fis`}></span>
      <span class="player-name">{name}</span>
      {tag && <span class="player-tag">{tag}</span>}
    </div>
    <div>
      <span class="player-in">Miembro desde: {inDate || '2018-09-06'}</span>
    </div>
    {fc && (
      <div>
        <span class="player-fc">{fc}</span>
      </div>
    )}
  </div>
</div>
