---
import GlobalNav from './GlobalNav.astro';
import SocialNav from './SocialNav.astro';
---

<header id="header">
  <div class="inner">
    <section class="logo">
      <a href="/">
        <img class="img-responsive" src="/images/disboard-logo-alt.svg" alt="Disboard logo" />
      </a>
    </section>

    <div class="global-navi-trigger sp-b" id="menu-trigger" aria-label="Abrir menú" role="button" tabindex="0">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <SocialNav idPrefix="header" />
    <GlobalNav />
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer">
  <GlobalNav />
  <SocialNav idPrefix="drawer" />
</div>

<script>
  const trigger = document.getElementById('menu-trigger');
  const drawer = document.getElementById('mobile-drawer');

  if (trigger && drawer) {
    trigger.addEventListener('click', () => {
      drawer.classList.toggle('is-open');
      trigger.classList.toggle('active');
    });
  }
</script>

<style>
  .mobile-drawer {
    display: none;
  }
  @media only screen and (max-width: 1000px) {
    .mobile-drawer {
      display: none;
      background: rgba(5, 7, 7, 0.95);
      border-top: 1px solid rgba(191, 19, 117, 0.6);
      padding: 20px;
      text-align: center;
    }
    .mobile-drawer.is-open {
      display: block;
    }
    .mobile-drawer :global(.global-navi) {
      display: block;
      float: none;
      margin: 0 0 20px 0;
    }
    .mobile-drawer :global(.global-navi ul) {
      display: flex;
      flex-direction: column;
      gap: 15px;
      padding: 0;
    }
    .mobile-drawer :global(.global-navi ul li) {
      float: none;
      margin: 0 !important;
    }
    .mobile-drawer :global(.global-navi ul li:before) {
      display: none !important;
    }
    .mobile-drawer :global(.social-navi) {
      display: block;
      float: none;
      margin: 0;
    }
  }
</style>
