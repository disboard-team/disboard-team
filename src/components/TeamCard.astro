---
interface Props {
  name: string;
  tag: string;
  logo: string;
  mkc_profile: string;
}

const { name, tag, logo, mkc_profile } = Astro.props;
---

<div class="team-card-inner">
  <div class="team-logo-wrap">
    <img src={logo} alt={name} loading="lazy" />
  </div>
  <div class="team-description">
    <div class="team-header-row">
      <span class="team-name" title={name}>{name}</span>
      <span class="team-tag">{tag}</span>
    </div>
    {mkc_profile && (
      <div class="team-action">
        <a href={mkc_profile} target="_blank" rel="noopener noreferrer" class="team-mkc-link">
          <span>MKC</span>
          <i class="ri-arrow-right-s-line"></i>
        </a>
      </div>
    )}
  </div>
</div>
